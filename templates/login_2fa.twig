{% extends '_auth_base.twig' %}
{% block title %}{{ t('login.two_factor') }}{% endblock %}
{% block content %}
    <h1>{{ t('login.two_factor') }}</h1>
    <p>{{ t('login.two_factor_hint') }}</p>
    {% if error %}
        <p class="error" role="alert">{{ t(error) }}</p>
    {% endif %}
    <form method="post" action="/login/2fa">
        {{ csrf_field() }}
        <p>
            <label for="code">{{ t('login.two_factor') }}</label>
            <input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9 ]*" maxlength="7"
                   autocomplete="one-time-code" required autofocus>
        </p>
        <button type="submit">{{ t('login.submit') }}</button>
    </form>
    <details>
        <summary>{{ t('login.use_backup_code') }}</summary>
        <form method="post" action="/login/2fa">
            {{ csrf_field() }}
            <p>
                <label for="backup-code">{{ t('login.backup_code') }}</label>
                <input id="backup-code" name="code" type="text" autocomplete="off" autocapitalize="characters"
                       spellcheck="false" maxlength="16" required>
            </p>
            <button type="submit">{{ t('login.submit') }}</button>
        </form>
    </details>
    <form method="post" action="/logout">
        {{ csrf_field() }}
        <button type="submit">{{ t('login.back') }}</button>
    </form>
{% endblock %}
