{% extends '_auth_base.twig' %}
{% block title %}{{ t('login.two_factor') }}{% endblock %}
{% block content %}
    <h1>{{ t('login.two_factor') }}</h1>
    <p class="auth-sub">{{ t('login.two_factor_hint') }}</p>
    {% if error %}
        <p class="warn" role="alert">{{ t(error) }}</p>
    {% endif %}
    <form class="form-grid form-tight" method="post" action="/login/2fa">
        {{ csrf_field() }}
        <div class="field">
            <label for="code">{{ t('login.two_factor') }}</label>
            <input id="code" class="input-otp" name="code" type="text" inputmode="numeric" pattern="[0-9 ]*" maxlength="7"
                   autocomplete="one-time-code" required autofocus>
        </div>
        <button class="btn btn-primary btn-wide" type="submit">{{ t('login.submit') }}</button>
    </form>
    <details class="auth-details">
        <summary>{{ t('login.use_backup_code') }}</summary>
        <form class="form-grid form-tight" method="post" action="/login/2fa">
            {{ csrf_field() }}
            <div class="field">
                <label for="backup-code">{{ t('login.backup_code') }}</label>
                <input id="backup-code" name="code" type="text" autocomplete="off" autocapitalize="characters"
                       spellcheck="false" maxlength="16" required>
            </div>
            <button class="btn btn-primary btn-wide" type="submit">{{ t('login.submit') }}</button>
        </form>
    </details>
    <form class="auth-secondary" method="post" action="/logout">
        {{ csrf_field() }}
        <button class="link-button" type="submit">← {{ t('login.back') }}</button>
    </form>
{% endblock %}
