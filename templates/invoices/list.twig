{% extends 'layout.twig' %}
{% import '_icons.twig' as icons %}
{% block title %}{{ t('invoice.list_title') }}{% endblock %}
{% block subtitle %}{{ t('invoice.list_subtitle') }}{% endblock %}
{% block actions %}<a class="btn btn-primary" href="/invoices/new">{{ icons.icon('plus') }}{{ t('invoice.new') }}</a>{% endblock %}
{% block content %}
{% if flash %}<p class="{{ flash.kind == 'warn' ? 'warn-box' : 'notice' }}" role="status">{{ flash.text }}</p>{% endif %}
{% if total == 0 and not filtered %}
    <section class="card empty-state">
        <h2>{{ t('invoice.list_empty') }}</h2>
        <p>{{ t('invoice.list_empty_text') }}</p>
        <p><a class="btn btn-primary" href="/invoices/new">{{ icons.icon('plus') }}{{ t('invoice.new') }}</a></p>
    </section>
{% else %}
    <section class="panel">
        <div class="panel-head">
            <form class="inline-form filters" method="get" action="/invoices" role="search">
                <input type="search" name="q" value="{{ q }}" placeholder="{{ t('invoice.search') }}" aria-label="{{ t('invoice.search') }}" maxlength="100">
                <label class="sr-only" for="flt-status">{{ t('invoice.filter_status') }}</label>
                <select id="flt-status" name="status">
                    <option value="">{{ t('invoice.filter_all_statuses') }}</option>
                    {% for s in statuses %}<option value="{{ s }}"{{ status == s ? ' selected' : '' }}>{{ t('invoice.status_' ~ s) }}</option>{% endfor %}
                </select>
                <label class="sr-only" for="flt-type">{{ t('invoice.filter_type') }}</label>
                <select id="flt-type" name="type">
                    <option value="">{{ t('invoice.filter_all_types') }}</option>
                    {% for ty in types %}<option value="{{ ty }}"{{ type == ty ? ' selected' : '' }}>{{ t('invoice.type_' ~ ty) }}</option>{% endfor %}
                </select>
                <button class="btn btn-ghost btn-sm" type="submit">{{ t('invoice.search_button') }}</button>
                {% if filtered %}<a class="link-button" href="/invoices">{{ t('invoice.filter_reset') }}</a>{% endif %}
            </form>
        </div>
        <div class="tbl-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ t('table.number') }}</th>
                        <th>{{ t('table.customer') }}</th>
                        <th>{{ t('invoice.col_type') }}</th>
                        <th>{{ t('table.date') }}</th>
                        <th>{{ t('table.due') }}</th>
                        <th class="r">{{ t('table.amount') }}</th>
                        <th>{{ t('table.status') }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for r in rows %}
                    <tr data-doc-row>
                        <td><a class="strong-link" href="/invoices/{{ r.id }}">{{ r.number ?: t('invoice.draft_number') }}</a></td>
                        <td class="wrap">{{ r.buyer }}{% if r.reverse_charge %}<small class="cell-sub">{{ t('invoice.reverse_charge') }} · {{ r.currency }}</small>{% endif %}</td>
                        <td><span class="chip chip-outline">{{ t('invoice.type_' ~ r.type) }}</span></td>
                        <td>{{ r.issue_date ?? '—' }}</td>
                        <td>{{ r.due_date ?? '—' }}</td>
                        <td class="r num">{{ r.amount }}</td>
                        <td><span class="chip {{ r.chip }}">{{ t('invoice.status_' ~ r.status) }}</span></td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="empty-row">{{ t('invoice.list_no_results') }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% if pages > 1 %}
            <nav class="pager" aria-label="{{ t('invoice.pagination') }}">
                {% if prev %}<a class="btn btn-ghost btn-sm" href="{{ prev }}" rel="prev">{{ t('invoice.prev') }}</a>{% endif %}
                <span>{{ t('invoice.page_info', {page: page, pages: pages}) }}</span>
                {% if next %}<a class="btn btn-ghost btn-sm" href="{{ next }}" rel="next">{{ t('invoice.next') }}</a>{% endif %}
            </nav>
        {% endif %}
    </section>
{% endif %}
{% endblock %}
