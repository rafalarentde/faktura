{# Step 1 of a new invoice: choose the customer (GET), then the editor opens with the customer's
   defaults (language, currency, due date from the payment days). #}
{% extends 'layout.twig' %}
{% import '_icons.twig' as icons %}
{% block title %}{{ t('invoice.new') }}{% endblock %}
{% block subtitle %}{{ t('invoice.new_subtitle') }}{% endblock %}
{% block actions %}<a class="btn btn-ghost" href="/invoices">{{ t('invoice.back_to_list') }}</a>{% endblock %}
{% block content %}
{% if customers %}
    <section class="panel panel-narrow">
        <div class="panel-head"><h2>{{ t('invoice.choose_customer') }}</h2></div>
        <form class="form-grid" method="get" action="/invoices/new">
            {% if error %}<p class="warn" role="alert">{{ error }}</p>{% endif %}
            <div class="field">
                <label for="n-customer">{{ t('invoice.customer') }}</label>
                <select id="n-customer" name="customer_id">
                    {% for c in customers %}<option value="{{ c.id }}">{{ c.name }} ({{ c.country }})</option>{% endfor %}
                </select>
                <p class="hint">{{ t('invoice.choose_customer_text') }}</p>
            </div>
            <div class="form-actions"><button class="btn btn-primary" type="submit">{{ t('invoice.continue') }}</button></div>
        </form>
    </section>
{% else %}
    <section class="card empty-state">
        <h2>{{ t('invoice.no_customers') }}</h2>
        <p>{{ t('invoice.no_customers_text') }}</p>
        <p><a class="btn btn-primary" href="/customers#customer-form">{{ icons.icon('plus') }}{{ t('invoice.create_customer') }}</a></p>
    </section>
{% endif %}
{% endblock %}
