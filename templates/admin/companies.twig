{% extends '_auth_base.twig' %}
{% block title %}{{ t('admin.title') }}{% endblock %}
{% block content %}
    <header>
        <h1>{{ t('admin.title') }}</h1>
        <p>{{ t('admin.subtitle') }}</p>
        <p><a href="/admin/companies/new">{{ t('admin.new_company') }}</a></p>
    </header>
    {% if error %}<p role="alert">{{ error }}</p>{% endif %}
    <table>
        <thead>
            <tr>
                <th>{{ t('admin.col_company') }}</th>
                <th>{{ t('admin.col_plan') }}</th>
                <th>{{ t('admin.col_until') }}</th>
                <th>{{ t('admin.col_users') }}</th>
                <th>{{ t('admin.col_access') }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for c in companies %}
            <tr>
                <td><a href="/admin/companies/{{ c.id }}">{{ c.name }}</a></td>
                <td>{{ c.plan }}</td>
                <td>{{ c.access_until ? c.access_until|slice(0, 10) : '' }}</td>
                <td>{{ c.user_count }}</td>
                <td>
                    {% if c.access_status == 'active' %}{{ t('admin.status_active') }}
                    {% elseif c.access_status == 'trial' %}{{ t('admin.status_trial') }}
                    {% else %}{{ t('admin.status_suspended') }}{% endif %}
                </td>
                <td>
                    {% if c.access_status != 'active' %}
                    <form method="post" action="/admin/companies/{{ c.id }}/access">
                        {{ csrf_field() }}
                        <input type="hidden" name="action" value="activate">
                        <input type="date" name="until" value="{{ default_until }}" aria-label="{{ t('admin.until_label') }}">
                        <button type="submit">{{ t('admin.activate') }}</button>
                    </form>
                    {% endif %}
                    {% if c.access_status != 'suspended' %}
                    <form method="post" action="/admin/companies/{{ c.id }}/access">
                        {{ csrf_field() }}
                        <input type="hidden" name="action" value="suspend">
                        <button type="submit">{{ t('admin.block') }}</button>
                    </form>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <p>{{ t('admin.hint') }}</p>
{% endblock %}
