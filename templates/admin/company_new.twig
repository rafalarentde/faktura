{% extends '_auth_base.twig' %}
{% block title %}{{ t('admin.new_company') }}{% endblock %}
{% block content %}
    <h1>{{ t('admin.new_company') }}</h1>
    {% if error %}<p role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="/admin/companies">
        {{ csrf_field() }}
        <p><label>{{ t('admin.company_name') }}<br><input name="name" value="{{ form.name }}" maxlength="190" required></label></p>
        <p><label>{{ t('admin.plan') }}<br><input name="plan" value="{{ form.plan }}" maxlength="32"></label></p>
        <p><label>{{ t('admin.initial_status') }}<br>
            <select name="access_status">
                <option value="suspended"{{ form.access_status == 'suspended' ? ' selected' : '' }}>{{ t('admin.status_suspended') }}</option>
                <option value="active"{{ form.access_status == 'active' ? ' selected' : '' }}>{{ t('admin.status_active') }}</option>
                <option value="trial"{{ form.access_status == 'trial' ? ' selected' : '' }}>{{ t('admin.status_trial') }}</option>
            </select></label></p>
        <p><label>{{ t('admin.until_label') }}<br><input type="date" name="access_until" value="{{ form.access_until }}"></label></p>
        <button type="submit">{{ t('admin.create') }}</button>
    </form>
    <p><a href="/admin/companies">{{ t('admin.back') }}</a></p>
{% endblock %}
