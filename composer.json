{
    "name": "faktura/app",
    "description": "Invoicing web app",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "nikic/fast-route": "^1.3",
        "twig/twig": "^3.30",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^7.2",
        "spomky-labs/otphp": "^11.5",
        "endroid/qr-code": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
